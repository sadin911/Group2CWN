{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokecount-sabai-edition",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "pokef.tcgcount.com",
      "custom_domain": true
    }
  ]
}
