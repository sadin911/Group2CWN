{
  "name": "pokecounttracker",
  "private": true,
  "version": "3.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "data:prices": "node scripts/fetch-pokemon-prices.mjs",
    "rules:deploy": "npx -y firebase-tools deploy --only firestore:rules",
    "community:sync": "node scripts/sync-community-stats-admin.mjs",
    "rules:indexes:export": "node scripts/export-firestore-indexes.mjs",
    "firebase:login": "npx -y firebase-tools login",
    "indexes:deploy": "npx -y firebase-tools deploy --only firestore:indexes",
    "data:repair-thai-ratio": "node scripts/repair-thai-price-ratio.mjs",
    "meta:sync": "node scripts/fetch-limitless-meta.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "framer-motion": "^13.1.0",
    "pixi.js": "^8.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "firebase-admin": "^14.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
